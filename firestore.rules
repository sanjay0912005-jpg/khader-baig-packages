rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection validation
    match /test/{docId} {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Enquiry data validation helper
    function isValidEnquiry(data) {
      return data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 150
        && data.contactPerson is string && data.contactPerson.size() >= 1 && data.contactPerson.size() <= 100
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('productCategory' in data) || (data.productCategory is string && data.productCategory.size() <= 100))
        && (!('estimatedQuantity' in data) || (data.estimatedQuantity is string && data.estimatedQuantity.size() <= 100))
        && (!('customBranding' in data) || (data.customBranding is string && data.customBranding.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('source' in data) || (data.source is string && data.source.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Incoming B2B packaging enquiries
    match /enquiries/{enquiryId} {
      allow create: if isValidEnquiry(request.resource.data);
      allow read: if true;
      allow update: if isValidEnquiry(request.resource.data);
      allow delete: if false;
    }
  }
}
